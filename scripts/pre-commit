#!/bin/sh
set -e

echo ">>> Форматирование кода..."
make -C module2 format

echo ">>> Проверка, что форматирование не оставило изменений..."
if ! git diff --quiet; then
  echo ">>> Код был отформатирован. Изменения добавлены в индекс. Перезапустите коммит."
  git add -u
  exit 1
fi

echo ">>> Запуск тестов..."
make -C module2 test

echo ">>> Все проверки пройдены."